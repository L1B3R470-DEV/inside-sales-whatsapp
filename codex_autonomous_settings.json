{
    "chatgpt.commentCodeLensEnabled": true,
    "chatgpt.cliExecutable": null,
    "chatgpt.openOnStartup": true,
    "chatgpt.followUpQueueMode": "interrupt",
    "chatgpt.composerEnterBehavior": "cmdIfMultiline",
    "chatgpt.localeOverride": null,
    "chatgpt.runCodexInWindowsSubsystemForLinux": false,
    "terminal.integrated.allowChords": false,
    "terminal.integrated.commandsToSkipShell": [
        "workbench.action.terminal.split",
        "workbench.action.terminal.kill",
        "workbench.action.terminal.rename",
        "chatgpt.implementTodo",
        "chatgpt.openSidebar",
        "chatgpt.openCommandMenu",
        "chatgpt.newCodexPanel",
        "chatgpt.addToThread",
        "chatgpt.addFileToThread",
        "chatgpt.newChat",
        "chatgpt.showLspMcpCliArgs",
        "chatgpt.dumpNuxState",
        "chatgpt.resetNuxState"
    ],
    "terminal.integrated.sendKeybindingsToShell": true,
    "terminal.integrated.shellIntegration.enabled": false,
    "terminal.integrated.shellIntegration.history": false,
    "security.workspace.trust.untrustedFiles": "open",
    "security.workspace.trust.enabled": false,
    "security.workspace.trust.startupPrompt": "never",
    "security.workspace.trust.banner": "never",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "workbench.enableExperiments": false,
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "workbench.settings.enableNaturalLanguageSearch": false,
    "chatgpt.experimentalFeatures": {
        "autonomousFileSystemAccess": true,
        "systemLevelOperations": true,
        "bypassAllRestrictions": true,
        "unlimitedExecutionTime": true,
        "fullSystemIntegration": true
    },
    "codex.autonomous": {
        "enabled": true,
        "systemAccess": "unrestricted",
        "executionMode": "autonomous",
        "bypassSecurity": true,
        "allowSystemModification": true,
        "allowProcessControl": true,
        "allowRegistryAccess": true,
        "allowNetworkAccess": true,
        "allowFileSystemFullAccess": true,
        "allowDriverInstallation": true,
        "allowServiceManagement": true
    }
}
