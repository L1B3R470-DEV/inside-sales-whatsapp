# Ambiente virtual Python
.venv-router/
.venv*/

# Variáveis de ambiente (senhas, tokens)
.env

# Bancos de dados (grandes, binários, mudam constantemente)
*.sqlite
*.sqlite-shm
*.sqlite-journal
*.sqlite-wal

# Backups de banco n8n
n8n-database-backup-*.sqlite

# Logs
logs/
*.log

# Cache Python
__pycache__/
*.pyc

# Perfil temporário navegador
vivaldi_temp_profile/

# Arquivos grandes/binários que não precisam versionar
*.xlsx
*.png

# Exports CRM
crm_exports/

# Exports n8n (podem conter credenciais embutidas)
n8n_rebuild_export/

# Referência/cache gerado
reference_patterns_cache/
rag_vector_store/

# Datasets / modelos ML (13GB+)
CHATGPT_MACHINE_LEARNING/

# Instagram scraping (dados temporários)
ig_candidates/
ig_candidates2/
ig_direct_posts/
ig_meta_posts/
ig_sheet/
ig_profile.html
harambe_store_image_scraper/

# HTML capturados
chrome_dom.html
chrome_err.txt

# Arquivo morto (debug, backups, scripts únicos)
_archive/

# Temporários
*.tmp
*.bak

# Outputs de execução n8n (debug)
exec-*.txt
exec*.txt
tmp_*
_tmp_*
dashboard_*.html
artifacts/execution_*_expanded.json

# Artefatos locais/temporarios do Windows, WSL e ferramentas
.fuse_hidden*
remoteJid
sqlite_mcp_server.db
*.db
qr_reconectar.html
qr-*.png

# Dependencias instaladas localmente
node_modules/
sms-receive-module/
sms-receive-module/cache/*.json

# Evidencias geradas por testes e relatorios com snapshots/raws
stress-test-runs/
reports/**/backups_pre_change/
reports/**/*.jsonl
reports/**/responses_raw*.jsonl
reports/**/n8n_workflow*_before_patch.json
