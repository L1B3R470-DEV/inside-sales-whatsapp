# Required
EVOLUTION_API_KEY=123456
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_INSTANCE=my-instance
EVOLUTION_PAIRING_NUMBER=5575983211367
OPENAI_API_KEY=sk-your-openai-key

# Operational topology
ATTENDANT_OPERATIONAL_HOST_ROLE=PC_CLS
ATTENDANT_OPERATIONAL_HOST_IP=100.113.13.27
ATTENDANT_OPERATIONAL_DOCKER_HOST_ROLE=PC_CLS
ATTENDANT_OPERATIONAL_DOCKER_HOST_IP=100.113.13.27
ATTENDANT_INTERACTIVE_HOST_ROLE=PC_LBN
ATTENDANT_INTERACTIVE_HOST_IP=100.101.106.95
ATTENDANT_INTERACTIVE_MODE_ONLY=true
ATTENDANT_REJECT_LBN_AS_RUNTIME=true
ATTENDANT_REJECT_LBN_DOCKER=true

# Evolution database (required by latest image)
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=evolution

# Cost and behavior defaults
OPENAI_MODEL=gpt-5.4
SYSTEM_PROMPT=Responda educadamente a mensagem do cliente no WhatsApp. Seja claro e objetivo.
MAX_INPUT_CHARS=500
MAX_OUTPUT_CHARS=280
MAX_OUTPUT_TOKENS=120
MAX_MSGS_PER_HOUR=25
MAX_MSGS_PER_DAY=200
WORK_TIMEZONE=America/Bahia
WORK_DAYS=1,2,3,4,5
WORK_WINDOWS=08:00-12:00,13:30-18:00
OUT_OF_HOURS_MESSAGE=Atendimento automatico ativo de segunda a sexta, das 08:00 as 12:00 e das 13:30 as 18:00.
HIGH_VOLUME_MESSAGE=Estou com alto volume no momento. Tente novamente em alguns minutos.
N8N_ENCRYPTION_KEY=change-me-32-chars-or-more
AUTOMACAO_ROOT=C:\AUTOMACAO

# Anthropic (Claude) - optional dual-LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SALES=claude-sonnet-4-20250514
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_RETRY_ATTEMPTS=4
ANTHROPIC_RETRY_BASE_DELAY_SECONDS=0.8
ANTHROPIC_RETRY_MAX_DELAY_SECONDS=8
ANTHROPIC_OVERLOADED_COOLDOWN_SECONDS=45

# Local Router / RAG
ROUTER_BASE_URL=http://router:8091
ROUTER_OPENAI_EMBED_MODEL=text-embedding-3-small
ROUTER_WATCH_INTERVAL_SECONDS=900
ROUTER_QDRANT_COLLECTION=knowledge_chunks
ROUTER_CACHE_MIN_CONFIDENCE_LEARN=0.62
ROUTER_CACHE_SEMANTIC_ENABLED=true
ROUTER_CACHE_SEMANTIC_THRESHOLD=0.84
ROUTER_CACHE_SEMANTIC_CANDIDATE_LIMIT=120

# Google Sheets bidirectional sync (service account)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_AUTH_MODE=oauth_user
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/work/google-service-account.json
GOOGLE_OAUTH_CLIENT_SECRET_JSON_PATH=/work/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_JSON_PATH=/work/google-oauth-token.json
GOOGLE_SHEETS_TITLE=CRM Operacional Classe Couro
GOOGLE_SHARE_WITH_EMAIL=
